# Copy to test/.env and fill in before running the suite.

# Base URL of a running instance of the app (dev: ./gradlew bootRun, port 8080).
BASE_URL=http://localhost:8080

# --- Legacy username/password credentials -----------------------------------
# The AuthController username/password endpoint (POST /api/auth/login) stays
# active even when ENTRAID_ENABLED=true (see docs/production-readiness-audit-
# 2026-09-14.md, finding 1), so Playwright can log in without a real Entra ID
# flow. Point these at a real dev/test account seeded in your database.
# Leave blank to auto-skip every test that requires an authenticated session.
TEST_USERNAME=
TEST_PASSWORD=

# A second account with global admin=true, for admin-only screens/flows
# (User Management, Access Management, Automation Rules, Settings, etc.).
# Leave blank to auto-skip admin-only tests.
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=

# A known-bad password to exercise the invalid-login path — any value works,
# it never needs to succeed.
TEST_INVALID_PASSWORD=not-a-real-password
