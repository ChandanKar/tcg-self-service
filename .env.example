# =============================================================================
# .env.example - Copy this file to .env and update values
# =============================================================================

# =============================================================================
# Database Configuration (MySQL — both local dev and production)
# =============================================================================
DB_URL=jdbc:mysql://localhost:3306/db_self_service?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=root
DB_PASSWORD=
DB_PLATFORM=org.hibernate.dialect.MySQL8Dialect
JPA_DDL_AUTO=none

# =============================================================================
# Flyway Configuration
# =============================================================================
FLYWAY_CLEAN_ON_VALIDATION_ERROR=false
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_OUT_OF_ORDER=false

# =============================================================================
# Entra ID (Azure AD) OAuth2 Authentication
# =============================================================================
ENTRAID_ENABLED=true
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_REGION=ap-south-1

# =============================================================================
# VM State Sync Configuration
# =============================================================================
VM_STATE_SYNC_ENABLED=true
VM_STATE_SYNC_INTERVAL=300000
VM_STATE_SYNC_INITIAL_DELAY=60000

# =============================================================================
# EKS Sync Configuration
# =============================================================================
EKS_SYNC_ENABLED=true
EKS_SYNC_INTERVAL=300000    # NEW
EKS_SYNC_INITIAL_DELAY=60000  # NEW
# Comma-separated regions to scan for new EKS clusters, e.g. "ap-south-1,us-east-1" (defaults to AWS_REGION if unset)
EKS_SYNC_REGIONS=  # NEW

# =============================================================================
# Cost Management — cost-allocation tagging (Phase 1)          # NEW SECTION
# Writes tcg:managed-by/environment/team tags to real AWS EC2 instances and EKS
# node groups so Cost Explorer can group real billing data the same way estimated
# spend already is. Requires ec2:CreateTags, eks:TagResource, ce:UpdateCostAllocationTagsStatus,
# ce:ListCostAllocationTags on the AWS credential above — see docs/aws-iam-permissions.md.
# Disabled by default: writing to real AWS resource tags is a bigger blast radius
# than the rest of Cost Management, which is entirely read-only.
# =============================================================================
COST_TAGGING_ENABLED=false  # NEW
COST_TAGGING_KEY_PREFIX=tcg:  # NEW
COST_TAGGING_CRON=0 30 2 * * *  # NEW

# =============================================================================
# Cost Management — real billing ingestion (Phase 2)            # NEW SECTION
# Ingests real AWS cost via Cost Explorer's GetCostAndUsage, grouped by the
# tcg:environment tag from Phase 1 — requires that tag to already be active in
# Cost Explorer (up to 24h propagation after Phase 1 first tags resources).
# Requires ce:GetCostAndUsage, ce:GetTags — see docs/aws-iam-permissions.md.
# Disabled by default; runs once daily (billing data has ~24h latency, and each
# GetCostAndUsage call is both rate-limited and billed by AWS).
# =============================================================================
COST_ACTUALS_ENABLED=false  # NEW
COST_ACTUALS_CRON=0 0 5 * * *  # NEW

# =============================================================================
# Cost Management — AWS-native optimization signals (Phase 3)    # NEW SECTION
# Compute Optimizer overlays real EC2 rightsizing recommendations onto the
# rightsizing table (needs account opt-in + ~14 days of data; no EKS node-group
# support, those stay on the CPU-threshold rule). Requires
# compute-optimizer:GetEC2InstanceRecommendations, compute-optimizer:GetEnrollmentStatus.
# Reservation/Savings-Plan coverage uses Cost Explorer (billed per call, like Phase 2) —
# requires ce:GetReservationCoverage, ce:GetReservationUtilization,
# ce:GetSavingsPlansCoverage, ce:GetSavingsPlansUtilization. Both disabled by default.
# =============================================================================
COST_OPTIMIZER_ENABLED=false  # NEW
COST_RESERVATIONS_ENABLED=false  # NEW
COST_RESERVATIONS_CRON=0 15 5 * * *  # NEW

# =============================================================================
# CloudWatch VM Metric Collection & Daily Rollup Configuration            # NEW SECTION
# =============================================================================
# Master switch for CloudWatch CPU/network/disk metric collection (vm_metric_sample sync).
CLOUDWATCH_METRIC_ENABLE=true  # NEW
# Interval in MINUTES (not ms) between CloudWatch GetMetricData sync cycles.
CLOUDWATCH_METRIC_SCHEDULE_INTERVAL=5  # NEW
CLOUDWATCH_METRIC_SCHEDULE_INITIAL_DELAY=2  # NEW
# Rolls raw samples up into vm_metric_daily — what Cost Management's rightsizing table reads.
CLOUDWATCH_METRIC_ROLLUP_ENABLE=true  # NEW
CLOUDWATCH_METRIC_ROLLUP_SCHEDULE_INTERVAL=60  # NEW
CLOUDWATCH_METRIC_ROLLUP_SCHEDULE_INITIAL_DELAY=3  # NEW

# =============================================================================
# VM Auto-Discovery Configuration                                          # NEW SECTION
# =============================================================================
VM_DISCOVERY_ENABLED=false        # NEW
VM_DISCOVERY_STRATEGY=name-pattern  # NEW
VM_DISCOVERY_NAME_PREFIX=tcg-     # NEW

# =============================================================================
# User Management Configuration
# =============================================================================
APP_INITIAL_ADMIN_EMAIL=admin@example.com

